CERB_ENV=demo
CERB_PORT=80
CERB_SERVICE_TOKEN=sk_docker_token
CERB_SERVICE_TOKEN_SCOPE='cron update'

# PHP processes per pool. `web` serves page loads; `background` runs /queue and /cron
# drains -- see docker-compose.yml for how to size each.
#CERB_WEB_CHILDREN=6
#CERB_BACKGROUND_CHILDREN=4

# Database. MySQL creates this user during first-boot initialization only, so editing these
# later does not change the database -- it only changes what Cerb tries to connect with.
# To rotate the password on a running install, change it in MySQL first and then match it here:
#   docker compose exec mysql mysql -u cerb -p
#   ALTER USER CURRENT_USER() IDENTIFIED BY 'newpassword';
MYSQL_DATABASE=cerb
MYSQL_USER=cerb
MYSQL_PASSWORD=s3cr3t

# nginx worker processes. Defaults to 2; this tier only proxies to FPM, so it does not
# need one worker per core. `auto` restores the nginx default.
#CERB_NGINX_WORKERS=2
