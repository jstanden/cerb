{
  "package": {
    "name": "Connected Service: Telegram",
    "revision": 1,
    "requires": {
      "cerb_version": "11.0.7",
      "plugins": [

      ]
    },
    "library": {
      "name": "Telegram",
      "uri": "cerb_connected_service_telegram",
      "description": "Integration with Telegram",
      "instructions": "# Instructions\r\n\r\n* Enter your Bot Token from @BotFather",
      "point": "connected_service",
      "image": "data:image/png;base64,"
    },
    "configure": {
      "placeholders": [],
      "prompts": [
        {
          "type": "text",
          "label": "Bot Token",
          "key": "prompt_token",
          "params": {
            "default": "",
            "placeholder": "(paste your Bot Token)"
          }
        },
        {
          "type": "text",
          "label": "Alias",
          "key": "prompt_name",
          "params": {
            "default": "telegram",
            "placeholder": "(enter a URI, a-z,0-9,_)"
          }
        }
      ]
    }
  },
  "records": [
    {
      "uid": "service_telegram",
      "_context": "connected_service",
      "name": "Telegram",
      "extension_id": "cerb.service.provider.telegram.bot"
    },
    {
      "uid": "account_telegram",
      "_context": "connected_account",
      "name": "Telegram",
      "service_id": "{{{uid.service_telegram}}}",
      "owner__context": "cerberusweb.contexts.app",
      "owner_id": "0",
      "uri": "{{{prompt_name}}}",
      "params": {
        "token": "{{{prompt_token}}}"
      }
    }
  ]
}