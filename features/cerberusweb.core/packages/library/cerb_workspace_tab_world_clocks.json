{
  "package": {
    "library": {
      "name": "World Clocks",
      "uri": "cerb_workspace_tab_world_clocks",
      "description": "A dashboard with world clocks across major timezones",
      "point": "workspace_tab",
      "image": "clock"
    },
    "configure": {
      "prompts": [
        {
          "type": "chooser",
          "label": "Workspace Page",
          "key": "workspace_page_id",
          "hidden": true,
          "params": {
            "context": "cerberusweb.contexts.workspace.page",
            "single": true,
            "query": ""
          }
        }
      ],
      "placeholders": [

      ]
    }
  },
  "records": [
    {
      "uid": "workspace_tab_clocks",
      "_context": "workspace_tab",
      "name": "World Clocks",
      "page_id": "{{{workspace_page_id}}}",
      "extension_id": "core.workspace.tab.dashboard",
      "params": {
        "layout": ""
      }
    },
    {
      "uid": "clock_los_angeles",
      "_context": "cerberusweb.contexts.workspace.widget",
      "label": "Los Angeles",
      "extension_id": "core.workspace.widget.clock",
      "tab_id": "{{{uid.workspace_tab_clocks}}}",
      "pos": 1,
      "width_units": 1,
      "zone": "content",
      "params": {
        "timezone": "America/Los_Angeles",
        "format": "0",
        "color": "#007cbd"
      }
    },
    {
      "uid": "clock_denver",
