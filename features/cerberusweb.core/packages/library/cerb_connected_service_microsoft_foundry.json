{
  "package": {
    "name": "Connected Service: Microsoft Foundry",
    "revision": 1,
    "requires": {
      "cerb_version": "12.0.0",
      "plugins": []
    },
    "library": {
      "name": "Microsoft Foundry",
      "uri": "cerb_connected_service_microsoft_foundry",
      "description": "Integration with Microsoft Foundry (and Azure OpenAI)",
      "instructions": "# Instructions\r\n\r\n* In the Microsoft Foundry portal, open your resource and copy a key from **Keys and Endpoint**\r\n* Enter that key below\r\n* When you add an agent model, use this account for authentication and set the endpoint to your resource's OpenAI base URL:\r\n  * Microsoft Foundry: `https://YOUR-RESOURCE-NAME.services.ai.azure.com/openai/`\r\n  * Azure OpenAI: `https://YOUR-RESOURCE-NAME.openai.azure.com/openai`\r\n* On Foundry the last path segment varies by model family (e.g. `/anthropic`). Use the endpoint shown when you create the deployment.\r\n* The model is your **deployment name**, not the underlying model name\r\n\r\nFor OAuth2 with Microsoft 365 mailboxes (SMTP/POP3/IMAP), use the **Microsoft Entra ID** package instead.",
      "point": "connected_service",
      "image": "data:image/png;base64,"
    },
    "configure": {
      "placeholders": [],
      "prompts": [
        {
          "type": "text",
          "label": "API Key",
          "key": "prompt_api_key",
          "params": {
            "default": "",
            "placeholder": "(paste your API Key)"
          }
        },
        {
          "type": "text",
          "label": "Alias",
          "key": "prompt_name",
          "params": {
            "default": "foundry",
            "placeholder": "(enter a URI, a-z,0-9,_)"
          }
        }
      ]
    }
  },
  "records": [
    {
      "uid": "service_microsoft_foundry",
      "_context": "connected_service",
      "name": "Microsoft Foundry",
      "extension_id": "cerb.service.provider.token.bearer",
      "params": {
        "token_name": "Bearer"
      }
    },
    {
      "uid": "account_microsoft_foundry",
      "_context": "connected_account",
      "name": "Microsoft Foundry",
      "service_id": "{{{uid.service_microsoft_foundry}}}",
      "owner__context": "cerberusweb.contexts.app",
      "owner_id": "0",
      "uri": "{{{prompt_name}}}",
      "params": {
        "token": "{{{prompt_api_key}}}"
      }
    }
  ]
}