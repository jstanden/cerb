{
  "package": {
    "name": "Connected Service: OpenRouter",
    "revision": 1,
    "requires": {
      "cerb_version": "12.0.0",
      "plugins": []
    },
    "library": {
      "name": "OpenRouter",
      "uri": "cerb_connected_service_openrouter",
      "description": "Integration with OpenRouter",
      "instructions": "# Instructions\r\n\r\n* Enter your API key from <https://openrouter.ai/settings/keys>\r\n* When you add an agent model, choose the **OpenRouter** provider and this account for authentication\r\n* Model ids are namespaced by vendor (e.g. `anthropic/claude-sonnet-5`)",
      "point": "connected_service",
      "image": "data:image/png;base64,"
    },
    "configure": {
      "placeholders": [],
      "prompts": [
        {
          "type": "text",
          "label": "API Key",
          "key": "prompt_api_key",
          "params": {
            "default": "",
            "placeholder": "(paste your API Key)"
          }
        },
        {
          "type": "text",
          "label": "Alias",
          "key": "prompt_name",
          "params": {
            "default": "openrouter",
            "placeholder": "(enter a URI, a-z,0-9,_)"
          }
        }
      ]
    }
  },
  "records": [
    {
      "uid": "service_openrouter",
      "_context": "connected_service",
      "name": "OpenRouter",
      "extension_id": "cerb.service.provider.token.bearer",
      "params": {
        "token_name": "Bearer"
      }
    },
    {
      "uid": "account_openrouter",
      "_context": "connected_account",
      "name": "OpenRouter",
      "service_id": "{{{uid.service_openrouter}}}",
      "owner__context": "cerberusweb.contexts.app",
      "owner_id": "0",
      "uri": "{{{prompt_name}}}",
      "params": {
        "token": "{{{prompt_api_key}}}"
      }
    }
  ]
}