{
  "package": {
    "library": {
      "name": "Dashboard",
      "uri": "cerb_workspace_tab_dashboard",
      "description": "A dashboard with customizable widgets",
      "point": "workspace_tab",
      "image": "dashboard"
    },
    "configure": {
      "prompts": [
        {
          "type": "chooser",
          "label": "Workspace Page",
          "key": "workspace_page_id",
          "hidden": true,
          "params": {
            "context": "cerberusweb.contexts.workspace.page",
            "single": true,
            "query": ""
          }
        },
        {
          "type": "text",
          "label": "Name:",
          "key": "prompt_dashboard_name",
          "params": {
            "placeholder": "(e.g. Dashboard)",
            "default": "Dashboard"
          }
        },
        {
          "type": "picklist",
          "label": "Layout:",
          "key": "prompt_layout",
          "params": {
            "options": {"Open":"","Left Sidebar":"sidebar_left","Right Sidebar":"sidebar_right","3-Column":"thirds"},
            "default": ""
          }
        }
      ],
      "placeholders": [

      ]
    }
  },
  "records": [
    {
      "uid": "workspace_tab_dashboard",
      "_context": "workspace_tab",
      "name": "{{{prompt_dashboard_name}}}",
      "page_id": "{{{workspace_page_id}}}",
      "pos": 0,
      "extension_id": "core.workspace.tab.dashboard",
      "params": {
        "layout": "{{{prompt_layout}}}"
      }
    }
  ]
}