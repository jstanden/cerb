{
  "package": {
    "name": "Connected Service: Bluesky",
    "revision": 1,
    "requires": {
      "cerb_version": "11.0.7",
      "plugins": [

      ]
    },
    "library": {
      "name": "Bluesky",
      "uri": "cerb_connected_service_bluesky",
      "description": "Integration with Bluesky",
      "instructions": "# Instructions\r\n\r\n* Enter your Bluesky account details. See: <https://cerb.ai/solutions/integrations/bluesky/>",
      "point": "connected_service",
      "image": "data:image/png;base64,"
    },
    "configure": {
      "placeholders": [],
      "prompts": [
        {
          "type": "text",
          "label": "PDS Entryway URL",
          "key": "prompt_url",
          "params": {
            "default": "",
            "placeholder": "https://bsky.social"
          }
        },
        {
          "type": "text",
          "label": "Identifier",
          "key": "prompt_identifier",
          "params": {
            "default": "",
            "placeholder": "example.bsky.social"
          }
        },
        {
          "type": "text",
          "label": "Password",
          "key": "prompt_password",
          "params": {
            "default": "",
            "placeholder": "Your App Password"
          }
        },
        {
          "type": "text",
          "label": "Alias",
          "key": "prompt_name",
          "params": {
            "default": "bluesky",
            "placeholder": "(enter a URI, a-z,0-9,_)"
          }
        }
      ]
    }
  },
  "records": [
    {
      "uid": "service_bluesky",
      "_context": "connected_service",
      "name": "Bluesky",
      "extension_id": "cerb.service.provider.atproto",
      "params": {
        "pds_base_url": "{{{prompt_url}}}"
      }
    },
    {
      "uid": "account_bluesky",
      "_context": "connected_account",
      "name": "Bluesky",
      "service_id": "{{{uid.service_bluesky}}}",
      "owner__context": "cerberusweb.contexts.app",
      "owner_id": "0",
      "uri": "{{{prompt_name}}}",
      "params": {
        "identifier": "{{{prompt_identifier}}}",
        "password": "{{{prompt_password}}}"
      }
    }
  ]
}