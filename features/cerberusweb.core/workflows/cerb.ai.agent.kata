workflow:
  name: cerb.ai.agent
  version: 2026-08-28T01:00:00Z
  description: An AI agent chat in every editor, worklist, and the command bar
  website: https://cerb.ai/workflows/cerb.ai.agent/
  requirements:
    cerb_version: >=12.0 <12.1
    cerb_plugins: cerberusweb.core
records:
  automation/agentChat:
    fields:
      name: cerb.ai.agent.chat
      extension_id: cerb.trigger.interaction.worker.agent
      description: Chat with an AI agent
      script@raw:
        # The built-in Cerb agent, managed by the `cerb.ai.agent` workflow. Edits here are REPLACED on the
        # next update. To make your own, use Automations > Build > AI Agent Chat, which generates a copy you
        # own, then point an agent's `automation:` at it.

        start:
          set/init:
            prompt_agent@text:
            session_id: {{uuid()}}

          while:
            if@bool: yes
            do:
              # If the user sent a message, run an agent turn (this also runs any tools the agent calls).
              outcome/hasPrompt:
                if@bool: {{prompt_agent}}
                then:
                  llm.agent:
                    output: results
                    inputs:
                      # WHO this turn runs as, from the launcher rather than from this script. It carries the
                      # agent's instructions, tools, filesystems, terminal, and model policy, and stamps the
                      # session so the transcript shows that agent's own name and picture. Reading it from
                      # scope is what lets ONE interaction serve every agent.
                      agent@key: agent_id
                      session_id@key: session_id
                      messages:
                        message:
                          role: user
                          content@key: prompt_agent
                          images@key,optional: prompt_agent__images
                    on_success:
                      set:
                        session_id: {{results.session_id}}
                    # A failed turn (no model configured, provider error, rate limit, timeout) returns to the
                    # chat instead of ending the interaction: the composer restores the message that didn't
                    # send and shows the reason above it.
                    on_error:

              # Show the transcript and prompt for the next message.
              await/chat:
                form:
                  # The agent, by handle -- with its name alongside when that says something the handle doesn't.
                  title: {% if agent_at_mention_name %}@{{agent_at_mention_name}}{% if agent_name and agent_name != agent_at_mention_name %} ({{agent_name}}){% endif %}{% else %}{{agent_name|default('Agent')}}{% endif %}
                  elements:
                    llmTranscript/prompt_transcript:
                      session_id: {{session_id}}
                      # No `agent:` here on purpose. The transcript reads the AI worker the SESSION runs as
                      # (stamped by `llm.agent: agent:`), so it shows that agent's real name and picture --
                      # which is also why this script works for ANY agent rather than one named Cerb.
                      thinking: raw
                      tools: raw
                      expand: none
                      layout: interleaved
                      tokens@bool: yes
                    agentPrompt/prompt_agent:
                      placeholder: Message the agent...
                      session_id: {{session_id}}
                      required@bool: yes
                      agent@key: agent_id
                    submit:
                      continue@bool: no
                      reset@bool: no
      policy_kata@raw:
        # The agent turn is all this needs. The editor commands it calls are contributed by the trigger and
        # answered by the browser, and the `cerb` CLI is read-only reflection -- neither is a command this
        # policy gates. No `callers:` block: an absent one allows every caller, and naming `agent.pane` would
        # break resuming the chat from History.
        commands:
          llm.agent:
            allow@bool: yes
