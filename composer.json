		"php": ">=8.5",
		"ext-curl": "*",
		"ext-dom": "*",
		"ext-gd": "*",
		"ext-json": "*",
		"ext-libxml": "*",
		"ext-mailparse": "*",
		"ext-mbstring": "*",
		"ext-mysqli": "*",
		"ext-openssl": "*",
		"ext-simplexml": "*",
		"ext-yaml": "*",
		"ext-zip": "*",
		"smarty/smarty" : "v4.5.7",
		"symfony/mailer": "v8.0.12",
		"lcobucci/jwt": "5.6.0",
		"lcobucci/clock": "3.5.0",
		"dragonmantank/cron-expression": "v3.6.0",
		"onelogin/php-saml" : "4.3.2",
		"defuse/php-encryption" : "v2.4.0",
		"league/oauth2-server": "9.3.0",
