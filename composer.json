{
	"name" : "jstanden/cerb",
	"description" : "Cerb boosts team productivity with bot-powered email and workflow automation.",
	"type" : "project",
	"license" : "proprietary",
	"authors" : [
		{
			"name" : "Webgroup Media LLC",
			"email" : "team@cerb.ai",
			"homepage" : "https://cerb.ai/",
			"role" : "Developer / Publisher"
		}, {
			"name" : "Jeff Standen",
			"email" : "jeff@cerb.ai",
			"homepage" : "https://cerb.ai/",
			"role" : "Software Architect"
		}
	],
	"config": {
		"platform": {
			"php": "8.5"
		}
	},
	"require" : {
		"php": ">=8.5",
		"ext-curl": "*",
		"ext-dom": "*",
		"ext-gd": "*",
		"ext-json": "*",
		"ext-libxml": "*",
		"ext-mailparse": "*",
		"ext-mbstring": "*",
		"ext-mysqli": "*",
		"ext-openssl": "*",
		"ext-simplexml": "*",
		"ext-yaml": "*",
		"ext-zip": "*",
		"smarty/smarty" : "v4.5.6",
		"symfony/mailer": "v8.0.12",
		"lcobucci/jwt": "5.6.0",
		"lcobucci/clock": "3.5.0",
		"dragonmantank/cron-expression": "v3.6.0",
		"onelogin/php-saml" : "4.3.2",
		"defuse/php-encryption" : "v2.4.0",
		"league/oauth2-server": "9.3.0",
		"league/oauth2-client": "2.9.0",
		"guzzlehttp/guzzle": "7.12.1",
		"phpseclib/phpseclib": "3.0.54",
		"tijsverkoyen/css-to-inline-styles": "v2.4.0",
		"ezyang/htmlpurifier": "v4.19.0",
		"donatj/phpuseragentparser": "v1.11.0",
		"twig/twig" : "v3.27.1",
		"singpolyma/openpgp-php": "0.7.0",
		"bytestream/horde-imap-client": "v2.34.1",
		"ramsey/uuid": "4.9.2",
		"enshrined/svg-sanitize": "0.22.0",
		"sebastian/diff": "7.0.0",
		"league/commonmark": "2.8.2"
	},
	"require-dev" : {
		"phpunit/phpunit": "12.5.25"
	},
	"support" : {
		"email" : "team@cerb.ai",
		"issues" : "https://github.com/jstanden/cerb/issues/",
		"source" : "https://github.com/cerb/cerb-release/"
	},
	"scripts": {
		"cache-clear": [
			"rm -f storage/tmp/templates_c/*.php",
			"rm -f storage/tmp/cache--*"
		],
		"build-css": [
			"sass --no-source-map install/extras/developers/css/cerb.css/cerb.scss features/cerberusweb.core/resources/css/cerb.css"
		],
		"build-js": [
			"terser features/cerberusweb.core/resources/js/cerb-ui/_core.js features/cerberusweb.core/resources/js/cerb-ui/palettes.js features/cerberusweb.core/resources/js/cerb-ui/switcher.js features/cerberusweb.core/resources/js/cerb-ui/toggle.js features/cerberusweb.core/resources/js/cerb-ui/distbar.js features/cerberusweb.core/resources/js/cerb-ui/legend.js features/cerberusweb.core/resources/js/cerb-ui/time-ring.js features/cerberusweb.core/resources/js/cerb-ui/tooltip.js features/cerberusweb.core/resources/js/cerb-ui/menu.js features/cerberusweb.core/resources/js/cerb-ui/spinner.js features/cerberusweb.core/resources/js/cerb-ui/tabs.js features/cerberusweb.core/resources/js/cerb-ui/sparkchart.js -c -m -o features/cerberusweb.core/resources/js/cerb-ui.js"
		],
		"dist": [
			"@build-css",
			"@build-js"
		],
		"test": [
			"vendor/bin/phpunit --do-not-cache-result --display-phpunit-deprecations --bootstrap tests/bootstrap.platform.php -c tests/phpunit.cerb.platform.xml"
		]
	}
}
